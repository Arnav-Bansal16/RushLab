# P0 runs entirely in the browser and needs no secrets.
# Add optional integrations only after their architecture is approved.
NEXT_PUBLIC_DEMO_MODE=true

# Optional organizer accounts and private templates (Supabase).
# Only the project URL and PUBLIC publishable key belong here; never a service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
